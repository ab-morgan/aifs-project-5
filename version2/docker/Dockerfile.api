FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install base Python dependencies (shared with Streamlit app).
# Copy requirements from the version2 directory if they exist.
COPY version2/api/requirements.txt /tmp/api-requirements.txt

# Install FastAPI-specific dependencies
RUN pip install --no-cache-dir \
    fastapi>=0.110.0 \
    "uvicorn[standard]>=0.27.0" \
    python-multipart>=0.0.9 \
    numpy \
    sentence-transformers \
    supabase \
    requests \
    pydantic \
    python-dotenv \
    toml

# Install any additional api requirements
RUN pip install --no-cache-dir -r /tmp/api-requirements.txt || true

# Copy source
COPY version2/ /app/version2/

# version2/ is on the path so sibling packages resolve without prefix
ENV PYTHONPATH=/app/version2

EXPOSE 8000

CMD ["uvicorn", "version2.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
