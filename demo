#!/bin/bash

PID_FILE="/tmp/demo.pid"
OLLAMA_PID_FILE="/tmp/ollama.pid"
STREAMLIT_PID_FILE="/tmp/streamlit.pid"

log() { echo "[$(date +'%H:%M:%S')] $1"; }

case "$1" in
    "start")
        # Kill any existing
        $0 stop 2>/dev/null
        
        log "🚀 Starting demo with OLLAMA_TIMEOUT=300..."
        
        # Clean PIDs
        rm -f $PID_FILE $OLLAMA_PID_FILE $STREAMLIT_PID_FILE
        
        # Start Ollama WITH 5min timeout
        ollama serve &
        echo $! > $OLLAMA_PID_FILE
        log "✅ Ollama started (PID: $(cat $OLLAMA_PID_FILE)) - 5min timeout"
        sleep 5
        
        # Start Streamlit
        streamlit run app.py --server.headless true --server.port 8501 --server.address 0.0.0.0 &
        echo $! > $STREAMLIT_PID_FILE
        log "✅ Streamlit started (PID: $(cat $STREAMLIT_PID_FILE))"
        
        echo $$ > $PID_FILE
        log "🎉 Demo ready! Check ports panel for URLs"
        log "💡 Ctrl+C or './demo stop' to stop"
        
        # Keep alive
        while true; do sleep 30; done
        ;;
        
    "stop")
        log "🛑 Graceful shutdown..."
        [ -f "$OLLAMA_PID_FILE" ] && kill $(cat $OLLAMA_PID_FILE) 2>/dev/null
        [ -f "$STREAMLIT_PID_FILE" ] && kill $(cat $STREAMLIT_PID_FILE) 2>/dev/null
        sleep 3
        pkill -f "ollama serve" 2>/dev/null
        pkill -f "streamlit run" 2>/dev/null
        rm -f $PID_FILE $OLLAMA_PID_FILE $STREAMLIT_PID_FILE
        log "✅ All stopped"
        ;;
        
    "status")
        if [ -f "$PID_FILE" ] && [ -d "/proc/$(cat $PID_FILE)" ]; then
            echo "✅ Running | Ollama: $([ -d /proc/$(cat $OLLAMA_PID_FILE 2>/dev/null) ] && echo OK || echo DOWN)"
        else
            echo "⭕ Stopped"
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|status}"
        ;;
esac